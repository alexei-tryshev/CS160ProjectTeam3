# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Never commit .env — it holds real credentials. Only this example file is tracked.

# Flask session signing key. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas (example format only — use your own user, password, and cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

MONGO_DB_NAME=wellness_tracker
MONGO_SERVER_SELECTION_TIMEOUT_MS=1000

# true  = if MongoDB is down, run with an in-memory database (data is lost on restart)
# false = fail on startup if MongoDB is unreachable
ALLOW_MEMORY_FALLBACK=true